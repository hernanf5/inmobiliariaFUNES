@model inmobiliariaFUNES.Models.Reserva
@using inmobiliariaFUNES.Models

@{
    ViewData["Title"] = "Renovar reserva";
    var original = (Reserva)ViewBag.ReservaOrigen;
}

<h1 class="text-2xl font-semibold text-gray-900 mb-2">Renovar reserva</h1>
<p class="text-sm text-gray-600 mb-6">
    Se va a crear una reserva nueva para el mismo inmueble e inquilino. La reserva original (#@original.IdReserva) no se modifica.
</p>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl divide-y divide-gray-100 mb-6">
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Inmueble</span>
        <span class="text-gray-900">@original.Inmueble?.Direccion</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Inquilino</span>
        <span class="text-gray-900">@original.Inquilino?.Nombre @original.Inquilino?.Apellido</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Período original</span>
        <span class="text-gray-900">@original.FechaDesde.ToString("dd/MM/yyyy") - @original.FechaHastaOriginal.ToString("dd/MM/yyyy")</span>
    </div>
</div>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
    <form asp-action="Renovar" asp-route-id="@original.IdReserva" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="FechaDesde" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FechaDesde" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="FechaDesde" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="FechaHastaOriginal" class="block text-sm font-medium text-gray-700 mb-1">Nueva fecha hasta</label>
                <input asp-for="FechaHastaOriginal" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="FechaHastaOriginal" class="text-sm text-red-600"></span>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="MontoPorDia" class="block text-sm font-medium text-gray-700 mb-1">Nuevo monto por día</label>
            <input asp-for="MontoPorDia" type="number" step="0.01" min="0" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="MontoPorDia" class="text-sm text-red-600"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
                Confirmar renovación
            </button>
            <a asp-action="Index" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Cancelar
            </a>
        </div>
    </form>
</div>