@model IList<inmobiliariaFUNES.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Reservas</h1>
    <a asp-action="Create" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        + Nueva reserva
    </a>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800">
        @ViewBag.Mensaje
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
        @ViewBag.Error
    </div>
}
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Inmueble</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Inquilino</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Desde</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hasta</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500">
                        No hay reservas cargadas todavía.
                    </td>
                </tr>
            }
            @foreach (var r in Model)
            {
                <tr class="hover:bg-gray-50 @(r.IdReserva == (ViewBag.Id as int?) ? "bg-indigo-50" : "")">
                    <td class="px-4 py-3 text-sm text-gray-900">@r.Inmueble?.Direccion</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@r.Inquilino?.Nombre @r.Inquilino?.Apellido</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@r.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@r.FechaHastaOriginal.ToString("dd/MM/yyyy")</td>
                    <td class="px-4 py-3 text-sm">
                        @{
                            var (colorFondo, colorTexto) = r.Estado switch
                            {
                                "Vigente" => ("bg-green-100", "text-green-800"),
                                "Finalizada" => ("bg-gray-100", "text-gray-600"),
                                "Terminada anticipadamente" => ("bg-amber-100", "text-amber-800"),
                                _ => ("bg-red-100", "text-red-800"),
                            };
                        }
                        <span class="inline-flex rounded-full @colorFondo px-2 py-1 text-xs font-medium @colorTexto">@r.Estado</span>
                    </td>
                    <td class="px-4 py-3 text-sm text-right space-x-3">
                        <a asp-action="Details" asp-route-id="@r.IdReserva" class="text-gray-500 hover:text-gray-700">Ver</a>
                        @if (r.Estado == "Vigente")
                        {
                            <a asp-action="Edit" asp-route-id="@r.IdReserva" class="text-indigo-600 hover:text-indigo-800">Editar</a>
                            <a asp-action="Terminar" asp-route-id="@r.IdReserva" class="text-amber-600 hover:text-amber-800">Terminar</a>
                            <a asp-action="Eliminar" asp-route-id="@r.IdReserva" class="text-red-600 hover:text-red-800">Cancelar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    int paginaActual = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}
@if (totalPaginas > 1)
{
    <div class="mt-4 flex gap-2">
        @for (int i = 1; i <= totalPaginas; i++)
        {
            <a asp-action="Index" asp-route-pagina="@i"
                class="px-3 py-1 rounded-md text-sm @(i == paginaActual ? "bg-indigo-600 text-white" : "bg-white border border-gray-300 text-gray-700 hover:bg-gray-50")">
                    @i
            </a>
        }
    </div>
}