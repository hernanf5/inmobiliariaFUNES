@model inmobiliariaFUNES.Models.Reserva

@{
    ViewData["Title"] = "Terminar reserva anticipadamente";
}

<h1 class="text-2xl font-semibold text-gray-900 mb-2">Terminar reserva anticipadamente</h1>
<p class="text-sm text-gray-600 mb-6">
    Se calculará una multa según cuánto tiempo del alquiler ya se cumplió. No se devuelve dinero en ningún caso.
</p>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl divide-y divide-gray-100 mb-6">
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Inmueble</span>
        <span class="text-gray-900">@Model.Inmueble?.Direccion</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Inquilino</span>
        <span class="text-gray-900">@Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Período original</span>
        <span class="text-gray-900">@Model.FechaDesde.ToString("dd/MM/yyyy") - @Model.FechaHastaOriginal.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Monto por día</span>
        <span class="text-gray-900">$@Model.MontoPorDia.ToString("N2")</span>
    </div>
</div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
    <form asp-action="Terminar" asp-route-id="@Model.IdReserva" method="post">
        <div class="mb-4">
            <label for="fechaTerminacion" class="block text-sm font-medium text-gray-700 mb-1">Fecha de terminación</label>
            <input type="date" id="fechaTerminacion" name="fechaTerminacion"
                    value="@ViewBag.FechaTerminacion.ToString("yyyy-MM-dd")"
                    min="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                    max="@Model.FechaHastaOriginal.ToString("yyyy-MM-dd")"
                    data-fecha-desde="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                    data-fecha-hasta="@Model.FechaHastaOriginal.ToString("yyyy-MM-dd")"
                    data-monto-dia="@Model.MontoPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="mb-6 rounded-md bg-amber-50 border border-amber-200 px-4 py-3">
            <p class="text-sm text-amber-800">Multa estimada:</p>
            <p id="multaEstimada" class="text-lg font-semibold text-amber-900">$@ViewBag.MultaCalculada.ToString("N2")</p>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
                Confirmar terminación
            </button>
            <a asp-action="Index" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Cancelar
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.getElementById('fechaTerminacion').addEventListener('change', function () {
            const input = this;
            const fechaDesde = new Date(input.dataset.fechaDesde);
            const fechaHasta = new Date(input.dataset.fechaHasta);
            const montoDia = parseFloat(input.dataset.montoDia);
            const fechaTerminacion = new Date(input.value);

            const msPorDia = 1000 * 60 * 60 * 24;
            const duracionOriginalDias = (fechaHasta - fechaDesde) / msPorDia;
            const diasCumplidos = (fechaTerminacion - fechaDesde) / msPorDia;
            const diasRestantes = duracionOriginalDias - diasCumplidos;
            const montoRestante = diasRestantes * montoDia;

            const porcentajeMulta = diasCumplidos < (duracionOriginalDias / 2) ? 0.50 : 0.25;
            const multa = Math.round(montoRestante * porcentajeMulta * 100) / 100;

            document.getElementById('multaEstimada').textContent = '$' + multa.toFixed(2);
        });
    </script>
}