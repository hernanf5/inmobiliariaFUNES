@model IList<inmobiliariaFUNES.Models.Reserva>

@{
    ViewData["Title"] = "Reservas por terminar";
}

<div class="mb-6">
    <a asp-action="Index" class="text-sm text-indigo-600 hover:text-indigo-800">&larr; Volver a Reportes</a>
</div>

<h1 class="text-2xl font-semibold text-gray-900 mb-6">Reservas que terminan en los próximos @ViewBag.Dias días</h1>

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Inmueble</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Inquilino</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Termina</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500">
                        No hay reservas venciendo en ese plazo.
                    </td>
                </tr>
            }
            @foreach (var r in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-900">
                        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@r.IdReserva" class="hover:underline">@r.Inmueble?.Direccion</a>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600">@r.Inquilino?.Nombre @r.Inquilino?.Apellido</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@r.FechaHastaOriginal.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>