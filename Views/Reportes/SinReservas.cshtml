@model IList<inmobiliariaFUNES.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles sin reservas";
}

<div class="mb-6">
    <a asp-action="Index" class="text-sm text-indigo-600 hover:text-indigo-800">&larr; Volver a Reportes</a>
</div>

<h1 class="text-2xl font-semibold text-gray-900 mb-6">Inmuebles sin reservas en los últimos @ViewBag.Dias días</h1>

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dirección</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Propietario</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500">
                        Todos los inmuebles tuvieron alguna reserva en ese período.
                    </td>
                </tr>
            }
            @foreach (var i in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-900">
                        <a asp-controller="Inmuebles" asp-action="Details" asp-route-id="@i.IdInmueble" class="hover:underline">@i.Direccion</a>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600">@i.Propietario?.Nombre @i.Propietario?.Apellido</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@i.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>