@model inmobiliariaFUNES.Models.Inmueble

@{
    ViewData["Title"] = "Editar inmueble";
}

<h1 class="text-2xl font-semibold text-gray-900 mb-6">Editar inmueble</h1>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-2xl">
    <form asp-action="Edit" asp-route-id="@Model.IdInmueble" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="IdInmueble" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>
                <div class="mb-4">
            <label asp-for="Direccion" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Direccion" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="Direccion" class="text-sm text-red-600"></span>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="Cupo" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Cupo" type="number" min="1" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Cupo" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="PrecioPorDia" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PrecioPorDia" type="number" step="0.01" min="0" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="PrecioPorDia" class="text-sm text-red-600"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="PorcentajeReserva" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PorcentajeReserva" type="number" step="0.01" min="0" max="100" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="PorcentajeReserva" class="text-sm text-red-600"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
                <label asp-for="Latitud" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Latitud" type="number" step="0.000001" min="-90" max="90" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Latitud" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Longitud" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Longitud" type="number" step="0.000001" min="-180" max="180" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Longitud" class="text-sm text-red-600"></span>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
                @{
                    ViewData["NombreCampo"] = nameof(Model.IdPropietario);
                    ViewData["UrlBusqueda"] = Url.Action("Buscar", "Propietarios");
                    ViewData["Etiqueta"] = "Propietario";
                    ViewData["ValorInicial"] = Model.IdPropietario;
                    ViewData["TextoInicial"] = ViewBag.PropietarioSeleccionadoTexto;
                }
                @await Html.PartialAsync("_Autocompletar", ViewData)
            </div>
            <div>
                <label asp-for="IdTipoInmueble" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <select asp-for="IdTipoInmueble" asp-items="ViewBag.Tipos" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">-- Seleccionar --</option>
                </select>
                <span asp-validation-for="IdTipoInmueble" class="text-sm text-red-600"></span>
            </div>
        </div>
                @if (Model.Imagenes.Any())
        {
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Fotos actuales</label>
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var img in Model.Imagenes)
                    {
                        <div class="relative">
                            <img src="@img.Url" class="w-full h-20 object-cover rounded-md border border-gray-200" />
                            @if (img.EsPortada)
                            {
                                <span class="absolute top-1 left-1 rounded bg-indigo-600 px-1.5 py-0.5 text-[10px] font-medium text-white">Portada</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
                <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Reemplazar/agregar portada</label>
            <input asp-for="PortadaFile" type="file" accept="image/*" class="w-full text-sm text-gray-600 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
        </div>

        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Agregar más fotos a la galería</label>
            <input name="GaleriaFiles" type="file" accept="image/*" multiple class="w-full text-sm text-gray-600 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
        </div>

        <div class="flex gap-3">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
                Guardar cambios
            </button>
            <a asp-action="Index" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Cancelar
            </a>
        </div>
    </form>
</div>