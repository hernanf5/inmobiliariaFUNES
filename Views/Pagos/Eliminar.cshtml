@model inmobiliariaFUNES.Models.Pago
@using inmobiliariaFUNES.Models

@{
    ViewData["Title"] = "Anular pago";
    var reserva = (Reserva)ViewBag.Reserva;
}

<div class="mb-6">
    <a asp-action="Index" asp-route-idReserva="@reserva.IdReserva" class="text-sm text-indigo-600 hover:text-indigo-800">&larr; Volver a los pagos</a>
</div>

<h1 class="text-2xl font-semibold text-gray-900 mb-2">Anular pago</h1>
<p class="text-sm text-gray-600 mb-6">
    El pago no se borra: queda marcado como anulado y sigue apareciendo en el listado, para conservar el historial.
</p>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl divide-y divide-gray-100 mb-6">
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Concepto</span>
        <span class="text-gray-900">@Model.Concepto</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Fecha</span>
        <span class="text-gray-900">@Model.FechaPago.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="py-3 flex justify-between text-sm">
        <span class="text-gray-500">Importe</span>
        <span class="text-gray-900">$@Model.Importe.ToString("N2")</span>
    </div>
</div>

<form asp-action="Eliminar" asp-route-id="@Model.IdPago" method="post">
    <input type="hidden" asp-for="IdPago" />
    <div class="flex gap-3">
        <button type="submit" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
            Confirmar anulación
        </button>
        <a asp-action="Index" asp-route-idReserva="@reserva.IdReserva" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Cancelar
        </a>
    </div>
</form>