@model inmobiliariaFUNES.Models.Pago
@using inmobiliariaFUNES.Models

@{
    ViewData["Title"] = "Nuevo pago";
    var reserva = (Reserva)ViewBag.Reserva;
}

<div class="mb-6">
    <a asp-action="Index" asp-route-idReserva="@reserva.IdReserva" class="text-sm text-indigo-600 hover:text-indigo-800">&larr; Volver a los pagos</a>
</div>

<h1 class="text-2xl font-semibold text-gray-900 mb-1">Nuevo pago</h1>
<p class="text-sm text-gray-600 mb-6">Reserva #@reserva.IdReserva — @reserva.Inmueble?.Direccion</p>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="IdReserva" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <div class="mb-4">
            <label asp-for="Concepto" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Concepto" placeholder="Ej: Seña, Cuota 1, Pago total" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="Concepto" class="text-sm text-red-600"></span>
        </div>

        <div class="mb-4">
            <label asp-for="FechaPago" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="FechaPago" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="FechaPago" class="text-sm text-red-600"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Importe" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Importe" type="number" step="0.01" min="0" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="Importe" class="text-sm text-red-600"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
                Guardar
            </button>
            <a asp-action="Index" asp-route-idReserva="@reserva.IdReserva" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Cancelar
            </a>
        </div>
    </form>
</div>