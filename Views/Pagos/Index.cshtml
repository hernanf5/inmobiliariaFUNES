@model IList<inmobiliariaFUNES.Models.Pago>
@using inmobiliariaFUNES.Models

@{
    ViewData["Title"] = "Pagos";
    var reserva = (Reserva)ViewBag.Reserva;
}

<div class="mb-6">
    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva.IdReserva" class="text-sm text-indigo-600 hover:text-indigo-800">&larr; Volver a la reserva</a>
</div>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900">Pagos de la reserva #@reserva.IdReserva</h1>
        <p class="text-sm text-gray-600">@reserva.Inmueble?.Direccion — @reserva.Inquilino?.Nombre @reserva.Inquilino?.Apellido</p>
    </div>
    <a asp-action="Create" asp-route-idReserva="@reserva.IdReserva" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        + Nuevo pago
    </a>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800">
        @ViewBag.Mensaje
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
        @ViewBag.Error
    </div>
}
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Concepto</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Importe</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                @if (User.IsInRole("Administrador"))
                {
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Auditoría</th>
                }
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500">
                        Todavía no hay pagos registrados para esta reserva.
                    </td>
                </tr>
            }
            @foreach (var pago in Model)
            {
                <tr class="hover:bg-gray-50 @(pago.Estado != "Activo" ? "opacity-60" : "")">
                    <td class="px-4 py-3 text-sm text-gray-900">@pago.Concepto</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                    <td class="px-4 py-3 text-sm text-gray-600">$@pago.Importe.ToString("N2")</td>
                    <td class="px-4 py-3 text-sm">
                        @if (pago.Estado == "Activo")
                        {
                            <span class="inline-flex rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800">Activo</span>
                        }
                        else
                        {
                            <span class="inline-flex rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">Anulado</span>
                        }
                    </td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <td class="px-4 py-3 text-xs text-gray-500">
                            <div>Creó: @(pago.NombreUsuarioCreador ?? "—")</div>
                            @if (pago.NombreUsuarioAnulador != null)
                            {
                                <div>Anuló: @pago.NombreUsuarioAnulador</div>
                            }
                        </td>
                    }
                    <td class="px-4 py-3 text-sm text-right space-x-3">
                        @if (pago.Estado == "Activo")
                        {
                            <a asp-action="Edit" asp-route-id="@pago.IdPago" class="text-indigo-600 hover:text-indigo-800">Editar concepto</a>
                            <a asp-action="Eliminar" asp-route-id="@pago.IdPago" class="text-red-600 hover:text-red-800">Anular</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>