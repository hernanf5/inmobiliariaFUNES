@model inmobiliariaFUNES.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";
}

<h1 class="text-2xl font-semibold text-gray-900 mb-6">Mi perfil</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800">
        @ViewBag.Mensaje
    </div>
}

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl mb-6">
    <form asp-action="MiPerfil" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

        <div class="mb-4">
            <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Nombre" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="Nombre" class="text-sm text-red-600"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Email" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="Email" class="text-sm text-red-600"></span>
        </div>

        <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
            Guardar cambios
        </button>
    </form>
</div>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
    <h2 class="text-sm font-medium text-gray-700 mb-3">Contraseña</h2>
    <a asp-action="CambiarClave" asp-route-id="@Model.IdUsuario" class="text-sm text-indigo-600 hover:text-indigo-800">Cambiar mi contraseña</a>
</div>