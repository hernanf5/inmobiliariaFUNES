@model IList<inmobiliariaFUNES.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Usuarios</h1>
    <a asp-action="Create" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        + Nuevo usuario
    </a>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="mb-4 rounded-md bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800">
        @ViewBag.Mensaje
    </div>
}
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rol</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="px-4 py-8 text-center text-sm text-gray-500">
                        No hay usuarios cargados todavía.
                    </td>
                </tr>
            }
            @foreach (var u in Model)
            {
                <tr class="hover:bg-gray-50 @(u.IdUsuario == (ViewBag.Id as int?) ? "bg-indigo-50" : "")">
                    <td class="px-4 py-3 text-sm text-gray-900">@u.Nombre</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@u.Email</td>
                    <td class="px-4 py-3 text-sm text-gray-600">@u.RolNombre</td>
                    <td class="px-4 py-3 text-sm text-right space-x-3">
                        <a asp-action="Details" asp-route-id="@u.IdUsuario" class="text-gray-500 hover:text-gray-700">Ver</a>
                        <a asp-action="Edit" asp-route-id="@u.IdUsuario" class="text-indigo-600 hover:text-indigo-800">Editar</a>
                        <a asp-action="CambiarClave" asp-route-id="@u.IdUsuario" class="text-amber-600 hover:text-amber-800">Clave</a>
                        <a asp-action="Eliminar" asp-route-id="@u.IdUsuario" class="text-red-600 hover:text-red-800">Baja</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    int paginaActual = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}
@if (totalPaginas > 1)
{
    <div class="mt-4 flex gap-2">
        @for (int i = 1; i <= totalPaginas; i++)
        {
            <a asp-action="Index" asp-route-pagina="@i"
                class="px-3 py-1 rounded-md text-sm @(i == paginaActual ? "bg-indigo-600 text-white" : "bg-white border border-gray-300 text-gray-700 hover:bg-gray-50")">
                    @i
            </a>
        }
    </div>
}