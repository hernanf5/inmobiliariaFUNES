@model inmobiliariaFUNES.Models.LoginView

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="max-w-sm mx-auto mt-12">
    <h1 class="text-2xl font-semibold text-gray-900 mb-6 text-center">Iniciar sesión</h1>

    <div class="bg-white border border-gray-200 rounded-lg p-6">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Email" class="text-sm text-red-600"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Clave" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Clave" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Clave" class="text-sm text-red-600"></span>
            </div>

            <button type="submit" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
                Ingresar
            </button>
        </form>
    </div>
</div>