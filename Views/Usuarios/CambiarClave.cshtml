@model inmobiliariaFUNES.Models.Usuario

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1 class="text-2xl font-semibold text-gray-900 mb-2">Cambiar contraseña</h1>
<p class="text-sm text-gray-600 mb-6">@Model.Nombre (@Model.Email)</p>

@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
        @TempData["Error"]
    </div>
}

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
    <form asp-action="CambiarClave" asp-route-id="@Model.IdUsuario" method="post">
        <div class="mb-6">
            <label for="claveNueva" class="block text-sm font-medium text-gray-700 mb-1">Nueva contraseña</label>
            <input type="password" id="claveNueva" name="claveNueva" minlength="6" required
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="flex gap-3">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
                Cambiar contraseña
            </button>
            <a asp-action="Index" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Cancelar
            </a>
        </div>
    </form>
</div>