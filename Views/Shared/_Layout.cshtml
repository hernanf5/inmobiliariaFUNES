<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - inmobiliariaFUNES</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
</head>
<body>
    <header>
        <nav class="bg-white border-b border-gray-200 mb-6">
            <div class="max-w-5x1 mx-auto px-4">
                <div class="flex h-14 items-center justify-between">
                    <a class="font-semibold text-gray-900" asp-area="" asp-controller="Home" asp-action="Index">Inmobiliaria ULP</a>
                    <ul class="flex gap-6 text-sm">
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Propietarios" asp-action="Index">Propietarios</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Inquilinos" asp-action="Index">Inquilinos</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="TipoInmuebles" asp-action="Index">Tipos de inmueble</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Inmuebles" asp-action="Index">Inmuebles</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Reservas" asp-action="Index">Reservas</a>
                        </li>
                        <li>
                            <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Reportes" asp-action="Index">Reportes</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li>
                                <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li>
                                <a class="flex items-center gap-2 text-gray-600 hover:text-gray-900" asp-controller="Usuarios" asp-action="MiPerfil">
                                    @{
                                        var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
                                    }
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" class="w-6 h-6 rounded-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-[10px] font-medium text-gray-500">
                                            @(User.FindFirst("NombreCompleto")?.Value?.Substring(0, 1).ToUpper())
                                        </span>
                                    }
                                    @User.FindFirst("NombreCompleto")?.Value
                                </a>
                            </li>
                            <li>
                                <a class="text-gray-600 hover:text-gray-900" href="/salir">Salir</a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="rounded-md bg-indigo-600 px-3 py-1.5 text-white hover:bg-indigo-700" asp-controller="Usuarios" asp-action="Login">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="max-w-5xl mx-auto px-4">
        <main role="main" class="pb-8">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-gray-200 py-4 text-sm text-gray-500">
        <div class="max-w-5xl mx-auto px-4">
            &copy; 2026 - inmobiliariaFUNES - <a class="hover:text-gray-700" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/autocompletar.js" asp-append-version="true"></script>
    <script src="~/js/mapa-inmueble.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
